# Copia este archivo a ".env" y ajusta los valores.

# Cadena de conexión a PostgreSQL 17.
# Local con docker-compose (ver docker-compose.yml en la raíz del proyecto):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voto_seguro

# Secreto para firmar los tokens de sesión (JWT).
# IMPORTANTE: cambia esto por un valor largo y aleatorio antes de usar en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

PORT=4000

# Cuenta de administrador que se crea automáticamente la primera vez
# que corres "npm run migrate" (solo si no existe ya un administrador).
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=VotoSeguro2026
ADMIN_DEFAULT_NAME=Administrador

# En producción, restringe esto al dominio real de tu frontend
# (ej. https://voto-seguro-eten.vercel.app) en vez de dejarlo abierto.
CORS_ORIGIN=*
